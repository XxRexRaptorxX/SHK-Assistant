  "variables": [
    {
      "symbol": "m",
      "name": "Masse",
      "unit": "kg"
    },
    {
      "symbol": "c",
      "name": "Spezifische Wärmekapazität",
      "unit": "kJ/(kg*K)"
    },
    {
      "symbol": "dT",
      "name": "Temperaturdifferenz",
      "unit": "K",
      "label": "ΔT"
    }
  ],
  "constants": [],
  "result": {
    "symbol": "Q",
    "name": "Wärmemenge",
    "unit": "kJ",
    "units": [
      "kcal"
    ],
    "decimals": 2
  },
  "expression": "m * c * dT",
  "examples": [
