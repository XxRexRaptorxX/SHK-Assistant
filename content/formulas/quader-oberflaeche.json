{
  "id": "formula.geometrie.quader-oberflaeche",
  "visibility": "public",
  "status": "draft",
  "source": "Wikipedia „Quader“, https://de.wikipedia.org/wiki/Quader",
  "verifiedBy": "",
  "verifiedAt": "",
  "title": "Quaderoberfläche",
  "description": "Berechnet die Oberfläche eines Quaders aus Länge, Breite und Höhe.",
  "category": "Geometrie",
  "variables": [
    {
      "symbol": "l",
      "name": "Länge",
      "unit": "m"
    },
    {
      "symbol": "b",
      "name": "Breite",
      "unit": "m"
    },
    {
      "symbol": "h",
      "name": "Höhe",
      "unit": "m"
    }
  ],
  "constants": [],
  "result": {
    "symbol": "O",
    "name": "Oberfläche",
    "unit": "m^2",
    "decimals": 3
  },
  "expression": "2 * (l * b + l * h + b * h)",
  "examples": [
    {
      "inputs": {
        "l": "9 cm",
        "b": "4.5 cm",
        "h": "1 cm"
      },
      "expected": "108 cm^2",
      "note": "Rechenbeispiel aus dem Wikipedia-Artikel „Quader“"
    }
  ],
  "figure": "figure.quader"
}
