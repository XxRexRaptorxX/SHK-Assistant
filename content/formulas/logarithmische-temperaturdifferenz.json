  "title": "Mittlere logarithmische Temperaturdifferenz",
  "description": "Berechnet die mittlere Temperaturdifferenz eines Wärmetauschers aus den Temperaturdifferenzen an beiden Enden. Beide Werte müssen größer als null und verschieden sein.",
  "category": "Heizungstechnik",
  "variables": [
    {
      "symbol": "dT1",
      "label": "ΔT₁",
      "name": "Temperaturdifferenz an Ende 1",
      "term": "Temperaturdifferenz",
      "unit": "K",
      "min": 0.001
    },
    {
      "symbol": "dT2",
      "label": "ΔT₂",
      "name": "Temperaturdifferenz an Ende 2",
      "term": "Temperaturdifferenz",
      "unit": "K",
      "min": 0.001
    }
  ],
  "constants": [],
  "result": {
    "symbol": "dTm",
    "label": "ΔTₘ",
    "name": "Mittlere logarithmische Temperaturdifferenz",
    "term": "Temperaturdifferenz",
    "unit": "K",
    "decimals": 2
  },
  "expression": "(dT1 - dT2) / log(dT1 / dT2)",
  "examples": [
    {
      "inputs": {
        "dT1": 50,
        "dT2": 30
      },
      "expected": 39.15230377942435
