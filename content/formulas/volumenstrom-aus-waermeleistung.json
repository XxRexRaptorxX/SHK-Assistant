{
  "id": "formula.heizungstechnik.volumenstrom-aus-waermeleistung",
  "visibility": "public",
  "status": "draft",
  "source": "Wikipedia „Spezifische Wärmekapazität“, https://de.wikipedia.org/wiki/Spezifische_W%C3%A4rmekapazit%C3%A4t; Wikipedia „Massenstrom“, https://de.wikipedia.org/wiki/Massenstrom",
  "verifiedBy": "",
  "verifiedAt": "",
  "title": "Volumenstrom aus Wärmeleistung",
  "description": "Berechnet den nötigen Volumenstrom eines Heizkreises aus Wärmeleistung, Dichte, spezifischer Wärmekapazität und Spreizung, z. B. für die Pumpenauslegung.",
  "category": "Heizungstechnik",
  "variables": [
    {
      "symbol": "Qdot",
      "name": "Wärmeleistung",
      "unit": "kW",
      "label": "Q̇"
    },
    {
      "symbol": "rho",
      "name": "Dichte",
      "unit": "kg/m^3",
      "label": "ρ"
    },
    {
      "symbol": "c",
      "name": "Spezifische Wärmekapazität",
      "unit": "kJ/(kg*K)"
    },
    {
      "symbol": "dT",
      "label": "ΔT",
      "name": "Spreizung (Vorlauf – Rücklauf)",
      "term": "Spreizung",
      "unit": "K"
    }
  ],
  "constants": [],
  "result": {
    "symbol": "Vdot",
    "name": "Volumenstrom",
    "unit": "m^3/h",
    "decimals": 3,
    "label": "V̇"
  },
  "expression": "Qdot / (rho * c * dT)",
  "examples": [
    {
      "inputs": {
        "Qdot": 10,
        "rho": 1000,
        "c": 4.19,
        "dT": 20
      },
      "expected": 0.42959427207637235
    }
  ]
}
