  "title": "Kreisausschnittsfläche",
  "description": "Berechnet die Fläche eines Kreisausschnitts (Kreissektors) aus Durchmesser und Mittelpunktswinkel.",
  "category": "Geometrie",
  "variables": [
    {
      "symbol": "d",
      "name": "Durchmesser",
      "unit": "m"
    },
    {
      "symbol": "alpha",
      "label": "α",
      "name": "Mittelpunktswinkel",
      "term": "Winkel",
      "unit": "deg"
    }
  ],
  "constants": [
    {
      "symbol": "full",
      "label": "360°",
      "name": "Vollwinkel",
      "term": "Winkel",
      "value": "360 deg"
    }
  ],
  "result": {
    "symbol": "A",
    "label": "A◔",
    "name": "Fläche",
    "unit": "m^2",
    "decimals": 3
  },
  "expression": "pi * d^2 / 4 * alpha / full",
  "examples": [
    {
      "inputs": {
        "d": 2,
        "alpha": 90
      },
      "expected": 0.7853981633974483
    }
  ],
