  "title": "Antriebsleistung einer Pumpe",
  "description": "Berechnet die nötige Antriebsleistung einer Pumpe aus Druckerhöhung, Volumenstrom und Wirkungsgrad.",
  "category": "Hydraulik",
  "variables": [
    {
      "symbol": "dp",
      "label": "Δp",
      "name": "Druckerhöhung",
      "term": "Druck",
      "unit": "bar"
    },
    {
      "symbol": "Vdot",
      "name": "Volumenstrom",
      "unit": "m^3/h",
      "label": "V̇"
    },
    {
      "symbol": "eta",
      "name": "Wirkungsgrad",
      "unit": "",
      "label": "η",
      "min": 0.01,
      "max": 1,
      "description": "Als Dezimalzahl, z. B. 0,5 für 50 %"
    }
  ],
  "constants": [],
  "result": {
    "symbol": "P",
    "name": "Antriebsleistung",
    "term": "Leistung",
    "unit": "W",
    "decimals": 1
  },
  "expression": "dp * Vdot / eta",
  "examples": [
    {
      "inputs": {
        "dp": 0.5,
        "Vdot": 2,
        "eta": 0.25
      },
      "expected": 111.11111111111111
