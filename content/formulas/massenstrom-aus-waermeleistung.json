      "name": "Wärmeleistung",
      "unit": "kW",
      "label": "Q̇"
    },
    {
      "symbol": "c",
      "name": "Spezifische Wärmekapazität",
      "unit": "kJ/(kg*K)"
    },
    {
      "symbol": "dT",
      "label": "ΔT",
      "name": "Spreizung (Vorlauf – Rücklauf)",
      "term": "Spreizung",
      "unit": "K"
