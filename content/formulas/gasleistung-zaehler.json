        "min"
      ]
    },
    {
      "symbol": "Z",
      "name": "Zustandszahl",
      "unit": "",
      "min": 0
    },
    {
      "symbol": "H",
      "name": "Heiz- bzw. Brennwert im Normzustand",
      "unit": "kWh/m^3"
    }
  ],
  "constants": [],
  "result": {
    "symbol": "P",
    "name": "Gasleistung (Belastung)",
    "unit": "kW",
    "decimals": 2
  },
  "expression": "VB * Z * H / t",
