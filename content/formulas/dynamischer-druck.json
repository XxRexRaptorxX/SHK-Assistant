  "title": "Dynamischer Druck",
  "description": "Berechnet den dynamischen Druck aus Dichte und Strömungsgeschwindigkeit.",
  "category": "Hydraulik",
  "variables": [
    {
      "symbol": "rho",
      "label": "ρ",
      "name": "Dichte des strömenden Mediums",
      "term": "Dichte",
      "unit": "kg/m^3"
    },
    {
      "symbol": "v",
      "name": "Strömungsgeschwindigkeit",
      "unit": "m/s"
    }
  ],
  "constants": [],
  "result": {
    "symbol": "pdy",
    "name": "Dynamischer Druck",
    "unit": "Pa",
    "decimals": 2
  },
  "expression": "rho * v^2 / 2",
  "examples": [
    {
      "inputs": {
        "rho": 1000,
        "v": 2
      },
      "expected": 2000
