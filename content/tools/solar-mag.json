          "expression": "max(1.2, 0.1 * h + 0.4)",
          "rule": "0,1 bar je Meter + 0,4 bar, mindestens 1,2 bar. Am drucklosen Gefäß einstellen."
        },
        {
          "when": {
            "kollektor": "vakuum"
          },
          "expression": "0.1 * h + 1.7",
          "rule": "0,1 bar je Meter + 1,7 bar. Am drucklosen Gefäß einstellen."
        },
        {
          "when": {
            "hersteller": "vaillant"
          },
          "expression": "0.1 * h",
          "rule": "0,1 bar je Meter, ohne Zuschlag. Vaillant-Gefäße kommen mit 2,5 bar: am abgekoppelten Gefäß anpassen."
